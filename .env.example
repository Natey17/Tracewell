# Postgres connection used by packages/db (Prisma) and apps/server.
# Port 5433 (not 5432) so the Dockerized Postgres in docker-compose.yml
# doesn't collide with a locally-installed Postgres, if you have one.
DATABASE_URL="postgresql://tracewell:tracewell@localhost:5433/tracewell?schema=public"

# Anthropic API key used by the investigation agent (apps/server/src/agent)
ANTHROPIC_API_KEY=""

# Model used for the investigation agent
ANTHROPIC_MODEL="claude-sonnet-5"

# apps/server
PORT=4000

# Scanner cadence, in seconds
SCANNER_INTERVAL_SECONDS=30

# Thresholds the anomaly detectors use (see apps/server/src/scanner/detectors)
STUCK_ORDER_THRESHOLD_MINUTES=60
DATA_FLOW_GAP_THRESHOLD_MINUTES=120

# apps/web (Vite) — base URL of apps/server
VITE_API_BASE_URL="http://localhost:4000"
